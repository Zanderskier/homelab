#!/usr/bin/env bash
# {{ ansible_managed }}
# Edit ansible/templates/kiwix-update/kiwix-update.sh.j2 in the repo, not this file.
#
# Keeps each ZIM in kiwix_zims (host_vars/survival.yml) at its newest version:
#   find newest -> download to incoming/ (resumes) -> checksum -> size check -> old to archive/,
#   new to current/ -> restart Kiwix if anything changed. Nothing is ever deleted except a
#   download that failed its checksum.
# Logs: journalctl -u kiwix-update.service     Run now: systemctl start kiwix-update.service
set -uo pipefail
DIR={{ kiwix_dir }}
BASE={{ kiwix_base_url }}
MIN_PCT={{ kiwix_min_size_percent }}
status=0
changed=0

update_one() {          # $1 = name (without _YYYY-MM.zim), $2 = folder on the server
  local name="$1" folder="$2" newest have
  local url_dir="$BASE/$folder"

  # 1. The newest version on the server (the same pipeline you ran by hand)
  newest=$(curl -sL "$url_dir/" | grep -oE "${name}_[0-9]{4}-[0-9]{2}\.zim" | sort -u | tail -1)
  [ -n "$newest" ] || { echo "ERROR $name: no file with that name on $url_dir/"; return 1; }

  # 2. The version we have (if any)
  have=$(ls "$DIR/current" | grep -E "^${name}_[0-9]{4}-[0-9]{2}\.zim$" | sort | tail -1)
  if [ "$newest" = "$have" ]; then echo "ok    $name: up to date ($have)"; return 0; fi
  echo "new   $name: $newest (have: ${have:-nothing})"

  # 3. Enough free space? (the size comes from the server's Content-Length header)
  local need free
  need=$(curl -sIL "$url_dir/$newest" | grep -i '^content-length' | tail -1 | tr -dc '0-9')
  free=$(df --output=avail -B1 "$DIR/incoming" | tail -1)
  if [ -n "$need" ] && [ "$free" -lt "$need" ]; then
    echo "ERROR $name: needs $((need / 1024**3)) GB, only $((free / 1024**3)) GB free"; return 1
  fi

  # 4. Download (resumable) and its checksum, into incoming/
  cd "$DIR/incoming" || return 1
  wget -c -q "$url_dir/$newest" || { echo "ERROR $name: download failed (run again to resume)"; return 1; }
  # -O: always write to this name (without it, a second run would save "….sha256.1")
  wget -q -O "$newest.sha256" "$url_dir/$newest.sha256" || { echo "ERROR $name: couldn't get the .sha256"; return 1; }

  # 5. Checksum. A bad download is removed: it's not your copy, and resuming it can't fix it.
  if ! sha256sum -c --status "$newest.sha256"; then
    echo "ERROR $name: checksum FAILED, download removed"; rm -f "$newest"; return 1
  fi

  # 6. Size check: much smaller than what we have? Hold it for a human to look at.
  if [ -n "$have" ]; then
    local new_size old_size
    new_size=$(stat -c %s "$newest"); old_size=$(stat -c %s "$DIR/current/$have")
    if [ $((new_size * 100)) -lt $((old_size * MIN_PCT)) ]; then
      echo "HOLD  $name: $newest is $((new_size * 100 / old_size))% of the size of $have."
      echo "      Nothing changed. It's in incoming/. If it's fine, move it into current/ by hand."
      return 1
    fi
  fi

  # 7. Into place: the old version (and its .sha256) to archive/, the new one to current/
  [ -n "$have" ] && mv "$DIR/current/$have"* "$DIR/archive/"
  mv "$newest" "$newest.sha256" "$DIR/current/"
  echo "done  $name: $newest is live${have:+, $have moved to archive/}"
  changed=1
}

{% for z in kiwix_zims %}
update_one {{ z.name }} {{ z.folder }} || status=1
{% endfor %}

if [ "$changed" -eq 1 ]; then
  echo "Restarting Kiwix so it sees the new files"
  docker restart kiwix >/dev/null || status=1
fi
[ "$status" -eq 0 ] && echo "RESULT: OK" || echo "RESULT: FAILED or HELD (see the ERROR/HOLD lines above)"
exit "$status"
