# {{ ansible_managed }}
[Unit]
Description=Monthly Kiwix ZIM update (newest versions from {{ kiwix_base_url }})

[Timer]
# kiwix_update_time in host_vars/survival.yml is a complete systemd calendar expression.
OnCalendar={{ kiwix_update_time }}
# If the host was off at that time, run once when it's back.
Persistent=true

[Install]
WantedBy=timers.target
