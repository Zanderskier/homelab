# {{ ansible_managed }}
# Read by /usr/local/sbin/health-check. Root only: each URL can mark its check healthy.
# One Uptime Kuma push URL per check (health_check_push_urls.<name> in secrets.yml), ending in
# /api/push/<token>. Empty = that check isn't reported.
{% for c in health_checks %}
PUSH_URL_{{ c.name }}='{{ (health_check_push_urls | default({}))[c.name] | default('') }}'
{% endfor %}
