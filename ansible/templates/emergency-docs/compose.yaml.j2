# {{ ansible_managed }}
# Edit ansible/templates/emergency-docs/compose.yaml.j2 in the repo, not this file.
# Version: emergency_docs_nginx_version in ansible/inventory/host_vars/portainer.yml
name: emergency-docs

services:
  web:
    image: docker.io/library/nginx:{{ emergency_docs_nginx_version }}
    container_name: emergency-docs
    restart: unless-stopped
    ports:
      - "{{ emergency_docs_port }}:8080"
{% if emergency_docs_lan_htpasswd is defined %}
      - "{{ emergency_docs_lan_port }}:8081"
{% endif %}
    volumes:
      - {{ emergency_docs_site_dir }}:/usr/share/nginx/html:ro
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
{% if emergency_docs_lan_htpasswd is defined %}
      - ./htpasswd:/etc/nginx/htpasswd:ro
{% endif %}
    environment:
      TZ: {{ timezone }}
