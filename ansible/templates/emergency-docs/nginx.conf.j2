# {{ ansible_managed }}
# Edit ansible/templates/emergency-docs/nginx.conf.j2 in the repo, not this file.
#
# Serves the emergency docs site (files copied in by the emergency-docs repo's workflow).
#   :8080  behind the Cloudflare tunnel. Every request is checked with Authentik (forward auth,
#          https://docs.goauthentik.io/add-secure-apps/providers/proxy/server_nginx/).
{% if emergency_docs_lan_htpasswd is defined %}
#   :8081  LAN fallback (internet or Authentik down): HTTP basic auth.
{% endif %}

# cloudflared talks plain HTTP to this server, but the browser used HTTPS. Authentik needs the
# address the browser saw, so use the X-Forwarded-Proto header cloudflared sends.
map $http_x_forwarded_proto $docs_proto {
    default $scheme;
    https   https;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    location / {
        auth_request        /outpost.goauthentik.io/auth/nginx;
        error_page          401 = @goauthentik_proxy_signin;
        auth_request_set    $auth_cookie $upstream_http_set_cookie;
        add_header          Set-Cookie $auth_cookie;
        add_header          X-Robots-Tag "noindex, nofollow" always;
        add_header          Referrer-Policy no-referrer always;
        add_header          X-Content-Type-Options nosniff always;
        try_files           $uri $uri/ =404;
    }

    # Authentik's outpost: the login check (auth/nginx), the login redirect (start) and the
    # callback after logging in.
    location /outpost.goauthentik.io {
        proxy_pass              {{ authentik_outpost_url }}/outpost.goauthentik.io;
        proxy_set_header        Host $host;
        proxy_set_header        X-Original-URL $docs_proto://$http_host$request_uri;
        add_header              Set-Cookie $auth_cookie;
        auth_request_set        $auth_cookie $upstream_http_set_cookie;
        proxy_pass_request_body off;
        proxy_set_header        Content-Length "";
    }

    # Not logged in: send the browser to Authentik, which sends it back here afterwards.
    location @goauthentik_proxy_signin {
        internal;
        add_header Set-Cookie $auth_cookie;
        return 302 /outpost.goauthentik.io/start?rd=$docs_proto://$http_host$request_uri;
    }
}
{% if emergency_docs_lan_htpasswd is defined %}

server {
    listen 8081;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    auth_basic           "Family emergency guide";
    auth_basic_user_file /etc/nginx/htpasswd;

    location / {
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;
        try_files  $uri $uri/ =404;
    }
}
{% endif %}
