# Managed by Ansible (ansible/playbooks/portainer.yml). Edits here are overwritten on the next run.
# Version: portainer_version in ansible/inventory/group_vars/portainer_hosts.yml (same as the server)
# The Portainer server at {{ portainer_url }} connects to this agent on port {{ portainer_agent_port }}.
name: portainer-agent

services:
  agent:
    image: portainer/agent:{{ portainer_version }}
    container_name: portainer_agent
    restart: always
    ports:
      - "{{ portainer_agent_port }}:9001"
{% if portainer_agent_secret is defined %}
    environment:
      AGENT_SECRET: "{{ portainer_agent_secret }}"
{% endif %}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
      - /:/host
