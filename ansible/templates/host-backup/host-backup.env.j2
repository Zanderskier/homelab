# {{ ansible_managed }}
# Read by /usr/local/sbin/host-backup. Root only: it holds the PBS token secret.
PBS_REPOSITORY='{{ pbs_host_backup_token }}@{{ pbs_server }}:{{ pbs_datastore }}'
PBS_PASSWORD='{{ pbs_host_backup_secret }}'
PBS_FINGERPRINT='{{ pbs_fingerprint }}'
# Uptime Kuma push monitor for this host (host_backup_push_urls in secrets.yml). Empty = not reported.
PUSH_URL='{{ (host_backup_push_urls | default({}))[inventory_hostname] | default('') }}'
