# Copy to .env for local testing, or enter these as Environment variables in the Portainer stack.
PIA_USER=
PIA_PASSWORD=
PIA_REGION=CA_Vancouver

# the tracker session token (Preferences -> Security; create the session for the VPN IP/ASN
# with "Allow session to set dynamic seedbox" checked).
SEEDBOX_SESSION_COOKIE=
# Seconds between dynamic seedbox updates (tracker rate-limits to ~1/hour).
SEEDBOX_SYNC_INTERVAL=3600
