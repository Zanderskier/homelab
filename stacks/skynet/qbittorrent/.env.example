# Enter these as Environment variables in the Portainer stack (never commit real values).
PIA_USER=
PIA_PASSWORD=
PIA_REGION=CA_Vancouver

# seedbox-ip-sync sidecar: the tracker's "dynamic seedbox" endpoint, and a session cookie created
# for the VPN's IP/ASN with seedbox IP updates allowed, written as name=value.
SEEDBOX_SYNC_URL=
SEEDBOX_SESSION_COOKIE=
# Seconds between updates (the tracker rate-limits to about once an hour).
SEEDBOX_SYNC_INTERVAL=3600
