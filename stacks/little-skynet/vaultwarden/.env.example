DOMAIN=https://vaultwarden.failsafe.work
# Use an argon2 hash, not a plain token: docker exec -it vaultwarden /vaultwarden hash
ADMIN_TOKEN=
SIGNUPS_ALLOWED=false

SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Authentik OIDC. Keep SSO_ONLY=false so the break-glass master-password login still works.
SSO_ENABLED=
SSO_ONLY=false
SSO_AUTHORITY=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SCOPES=
SSO_ALLOW_UNKNOWN_EMAIL_VERIFICATION=
SSO_CLIENT_CACHE_EXPIRATION=
SSO_SIGNUPS_MATCH_EMAIL=
