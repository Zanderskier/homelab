# Lives only on the Immich VM at /mnt/immich/immich/.env. Never commit the real one.
# https://immich.app/docs/install/environment-variables
UPLOAD_LOCATION=./library
DB_DATA_LOCATION=./postgres
TZ=America/Los_Angeles
# Managed by Ansible from ansible/inventory/host_vars/immich.yml (immich_version). Don't edit by hand.
IMMICH_VERSION="v3.3.5"
# Only A-Za-z0-9, no special characters or spaces
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
