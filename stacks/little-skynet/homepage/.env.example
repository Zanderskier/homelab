# Comma-separated, no spaces. Add your public hostname if Homepage is published through the tunnel.
HOMEPAGE_ALLOWED_HOSTS=192.168.50.81:4000,192.168.50.81
TZ=America/Los_Angeles

# ---- Widget secrets (referenced as {{HOMEPAGE_VAR_*}} in /main/homepage/config/*.yaml)
# All optional: a missing one only breaks that tile's widget, the link still works.
HOMEPAGE_VAR_IMMICH_KEY=          # Immich > Account settings > API keys
HOMEPAGE_VAR_MEALIE_KEY=          # NEW. Mealie > Profile > Manage Your API Tokens
HOMEPAGE_VAR_PAPERLESS_KEY=       # Paperless > My Profile > API auth token
HOMEPAGE_VAR_PLEX_KEY=            # Plex token
HOMEPAGE_VAR_AUDIOBOOKSHELF_KEY=  # Audiobookshelf > Settings > Users > API token
HOMEPAGE_VAR_SEERR_KEY=           # Seerr > Settings > General > API key
HOMEPAGE_VAR_FILEBROWSER_USER=
HOMEPAGE_VAR_FILEBROWSER_PASS=
HOMEPAGE_VAR_SONARR_KEY=          # *arr apps: Settings > General > API key
HOMEPAGE_VAR_RADARR_KEY=
HOMEPAGE_VAR_BAZARR_KEY=          # NEW. Bazarr > Settings > General
HOMEPAGE_VAR_PROWLARR_KEY=
HOMEPAGE_VAR_QBITTORRENT_KEY=     # qBittorrent > Options > WebUI > Authentication > API key
HOMEPAGE_VAR_SABNZBD_KEY=
HOMEPAGE_VAR_TAUTULLI_KEY=
HOMEPAGE_VAR_GITEA_KEY=           # NEW. Gitea token, scopes: notification, repository, issue (read)
HOMEPAGE_VAR_PORTAINER_KEY=       # Portainer access token
HOMEPAGE_VAR_AUTHENTIK_KEY=       # NEW. API token for a user with "Can view User" + "Can view Event"
HOMEPAGE_VAR_PIHOLE_KEY=          # Pi-hole 6 app password
HOMEPAGE_VAR_TAILSCALE_KEY=       # Tailscale admin > Settings > Keys (API access token, expires)
HOMEPAGE_VAR_PVE_SKYNET_USER=     # Proxmox API token ID, e.g. homepage@pve!homepage (PVEAuditor role)
HOMEPAGE_VAR_PVE_SKYNET_PASS=     # token secret
HOMEPAGE_VAR_PVE_LSKY_USER=
HOMEPAGE_VAR_PVE_LSKY_PASS=
HOMEPAGE_VAR_PBS_USER=            # PBS API token ID, Audit role on the user AND the token
HOMEPAGE_VAR_PBS_PASS=
