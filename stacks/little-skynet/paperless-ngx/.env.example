# Postgres only reads this when the database is first created. For the existing database, set it to
# the CURRENT password ("paperless" in the old compose file) first, then rotate it (see docs/secrets.md).
PAPERLESS_DB_PASSWORD=

USERMAP_UID=1000
USERMAP_GID=1000
PAPERLESS_SECRET_KEY=
PAPERLESS_TIME_ZONE=America/Los_Angeles
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_URL=https://paperless.failsafe.work
PAPERLESS_ALLOWED_HOSTS=
PAPERLESS_USE_X_FORWARD_HOST=
PAPERLESS_USE_X_FORWARD_PORT=
PAPERLESS_CSRF_TRUSTED_ORIGINS=

# Authentik OIDC
PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
PAPERLESS_SOCIALACCOUNT_PROVIDERS=
PAPERLESS_LOGOUT_REDIRECT_URL=
PAPERLESS_SOCIAL_AUTO_SIGNUP=
PAPERLESS_SOCIALACCOUNT_ALLOW_SIGNUPS=
